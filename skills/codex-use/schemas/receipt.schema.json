{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-use.dev/schemas/receipt.schema.json",
  "title": "Codex-use Completion Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "changed_files", "verification", "assumptions_and_risks", "symbol_changes"],
  "properties": {
    "summary": { "type": "string" },
    "changed_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "summary"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "summary": { "type": "string" }
        }
      }
    },
    "assumptions_and_risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "symbol_changes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}